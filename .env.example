# --- core ---
DATABASE_URL=postgres://postgres:pw@localhost:5432/aia
# openssl rand -base64 32
ENCRYPTION_KEY=
# openssl rand -hex 32
APP_SECRET=
PORT=3000
DEFAULT_TIMEZONE=Europe/Kyiv
# public https URL of the service (Render gives you one). Needed for the Telegram webhook and OAuth callbacks.
PUBLIC_URL=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# webhook on Render, polling for local development
TELEGRAM_MODE=polling
# openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=
# the only user the bot talks to (ask @userinfobot)
OWNER_TELEGRAM_ID=

# --- OpenAI (the client's own key, contract 4.6) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_SEARCH_MODEL=gpt-4.1

# --- ElevenLabs (voice replies, optional) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Notion ---
NOTION_TOKEN=
NOTION_VERSION=2022-06-28

# --- Google (Calendar + YouTube); OAuth client of type "Web", redirect: PUBLIC_URL/oauth/google/callback ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Instagram API with Instagram Login; redirect: PUBLIC_URL/oauth/instagram/callback ---
META_APP_ID=
META_APP_SECRET=
