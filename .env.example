# --- core ---
DATABASE_URL=postgres://postgres:pw@localhost:5432/aia
# openssl rand -base64 32
ENCRYPTION_KEY=
# openssl rand -hex 32
APP_SECRET=
PORT=3000
DEFAULT_TIMEZONE=Europe/Kyiv
# public https URL of the service (Render gives you one). Needed for the Telegram webhook and OAuth callbacks.
PUBLIC_URL=

# --- web UI: login by one-time link from the bot (/web); optionally also by password (min 10 chars) ---
WEB_PASSWORD=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# webhook on Render, polling for local development
TELEGRAM_MODE=polling
# openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=
# the only user the bot talks to (ask @userinfobot)
OWNER_TELEGRAM_ID=

# --- OpenAI (the client's own key, contract 4.6) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_SEARCH_MODEL=gpt-4.1
OPENAI_REASONING_EFFORT=low
# live voice stays on a fast model (gpt-6.x adds ~0.6 s to first words)
OPENAI_VOICE_MODEL=gpt-4.1-mini

# --- ElevenLabs (voice replies, optional) ---
ELEVENLABS_API_KEY=
# voice is chosen in the cabinet (Опції → Голос); this is only an optional default
ELEVENLABS_VOICE_ID=
# quality (Telegram voice notes, briefings) and low-latency (live conversation) models
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_MODEL_FAST=eleven_v4_turbo

# --- Notion ---
NOTION_TOKEN=
NOTION_VERSION=2022-06-28

# --- Google (Calendar + YouTube); OAuth client of type "Web", redirect: PUBLIC_URL/oauth/google/callback ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Instagram API with Instagram Login; redirect: PUBLIC_URL/oauth/instagram/callback ---
META_APP_ID=
META_APP_SECRET=
